# Copy to keystore.properties (git-ignored) and fill in. Needed only for signed release builds.
# Create a key with:
#   keytool -genkeypair -v -keystore ~/.android/gallerydl-release.jks -alias gallerydl \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=/absolute/path/to/gallerydl-release.jks
storePassword=CHANGE_ME
keyAlias=gallerydl
keyPassword=CHANGE_ME
