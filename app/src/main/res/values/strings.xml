    <string name="settings_title">Settings</string>
    <string name="settings_pacing_title">Pacing</string>
    <string name="settings_pacing_body">Slow downloads down so that websites are less likely to block you.</string>
    <string name="option_sleep_request_title">Wait between requests</string>
    <string name="option_sleep_request_body">Pause between requests to a website. Enter seconds as one number or as a range, for example 4.0-8.0.</string>
    <string name="option_sleep_title">Wait between downloads</string>
    <string name="option_sleep_body">Pause before each file is downloaded. Enter seconds as one number or as a range, for example 1.0-3.0.</string>
    <string name="option_seconds_label">Seconds</string>
    <string name="error_duration">Please enter seconds from 0 to 300, as one number or a range such as 4.0-8.0.</string>
    <string name="settings_sites_title">Websites</string>
    <string name="settings_sites_body">Choices that only some websites offer.</string>
    <string name="option_api_rest_title">Use the REST API</string>
    <string name="option_api_rest_body">Asks websites that offer more than one API to use the REST API. Only some websites, such as Twitter, give this choice.</string>
    <string name="settings_apply_note">Changes apply to the next download that starts.</string>

    <string name="settings_location_title">Download location</string>
    <string name="settings_location_body">Where finished files are saved on your phone.</string>
    <string name="settings_connection_title">Connection</string>
    <string name="settings_connection_body">How downloads behave on slow or limited connections.</string>
    <string name="option_wifi_title">Wi-Fi only</string>
    <string name="option_wifi_body">Wait for Wi-Fi and never use mobile data. Downloads in the queue start when Wi-Fi is available.</string>
    <string name="option_retries_title">Retries</string>
    <string name="option_retries_body">How many times a file is tried again after it fails. The default is 4.</string>
    <string name="option_retries_label">Number of retries</string>
    <string name="error_retries">Please enter a whole number from 0 to 20.</string>
    <string name="option_timeout_title">Timeout</string>
    <string name="option_timeout_body">How many seconds to wait for a slow server before giving up. The default is 30.</string>
    <string name="error_timeout">Please enter seconds from 1 to 300.</string>
    <string name="option_skip_title">Skip files already downloaded</string>
    <string name="option_skip_body">When this is off, every file is downloaded again even if it was saved before, which can create duplicates.</string>
    <string name="settings_accounts_title">Accounts</string>
    <string name="settings_accounts_body">Download content that needs you to be signed in.</string>
    <string name="option_cookies_title">Use cookies</string>
    <string name="option_cookies_body">Sends your cookies.txt to websites so that you appear signed in. Export the file from a desktop browser and import it here.</string>
    <string name="cookies_none">No cookies.txt has been imported.</string>
    <plurals name="cookies_imported">
        <item quantity="one">cookies.txt imported with %d cookie.</item>
        <item quantity="other">cookies.txt imported with %d cookies.</item>
    </plurals>
    <string name="error_cookies_invalid">Unable to read this file. Please choose a cookies.txt file in the Netscape format.</string>
    <string name="action_import_file">Import file</string>
    <string name="action_replace_file">Replace file</string>
    <string name="remove_cookies_title">Remove the cookies?</string>
    <string name="remove_cookies_message">This will delete the imported cookies.txt from the app. You will need to import it again to download content that needs a sign-in.</string>
    <string name="settings_storage_title">Storage and reset</string>
    <string name="settings_storage_body">Manage what the app keeps on your phone.</string>
    <string name="storage_records">The app\'s records use %s.</string>
    <string name="storage_thumbnails">The saved thumbnails and preview clips of your library use %s.</string>
    <string name="action_clear_thumbnails">Clear thumbnail cache</string>
    <string name="clear_thumbnails_title">Clear the thumbnail cache?</string>
    <string name="clear_thumbnails_message">This removes the saved thumbnails and preview clips of the pictures and videos in your library. They are made again when needed. Your files are not touched.</string>
    <string name="action_clear_history">Clear finished history</string>
    <string name="action_reset_settings">Reset settings</string>
    <string name="reset_settings_title">Reset all settings?</string>
    <string name="reset_settings_message">This will return every option and the download location to its default. Your imported cookies, downloaded files and history will not be changed.</string>
    <string name="action_reset">Reset</string>
